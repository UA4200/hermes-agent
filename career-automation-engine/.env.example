# Copy to .env and fill in real values. Never commit .env.
# All of these live ONLY on the machine that actually runs the automation
# (your laptop) — this repo never carries real secrets.

# --- Claude API (job scoring) ---
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_BATCH_SIZE=10
FIT_THRESHOLD=70

# --- Tracker (plain CSV file, no account/API key needed) ---
# Leave as the default and it just works locally. To get it into real
# Google Drive/your phone with zero API setup: install Google Drive for
# Desktop, then point this at a file inside its synced folder, e.g.:
#   macOS:   ~/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/Career Application Engine/tracker.csv
#   Windows: G:\My Drive\Career Application Engine\tracker.csv
# Drive syncs the file automatically — no code, no cloud project, no token.
TRACKER_PATH=./data/tracker.csv

# --- Indeed (session-cookie based; see SETUP.md's ToS note) ---
INDEED_SESSION_COOKIE=
INDEED_ACCOUNT_EMAIL=nua.consult1@gmail.com

# --- LinkedIn (optional, off by default — see SETUP.md's ToS note) ---
LINKEDIN_SESSION_COOKIE=

# --- Applicant info used to fill forms ---
APPLICANT_FIRST_NAME=Nathan
APPLICANT_LAST_NAME=Asiegbu
APPLICANT_EMAIL=nua.consult1@gmail.com
APPLICANT_PHONE=312-522-0690
# Drop the resume PDF Claude sent you (pulled from your Drive) here as resume.pdf
RESUME_PATH=./resume.pdf

# --- Automation behavior ---
DASHBOARD_PORT=3000
HEADLESS_BROWSER=true
SCREENSHOT_ON_ERROR=true
SCREENSHOT_DIR=./screenshots
LOG_LEVEL=INFO
LOG_DIR=./logs
