# Copy to .env and fill in real values. Never commit .env.
# All of these live ONLY on the machine that actually runs the automation
# (your laptop) — this repo never carries real secrets.

# --- Claude API (job scoring) ---
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_BATCH_SIZE=10
FIT_THRESHOLD=70

# --- Notion tracker ---
# 1. notion.so/my-integrations -> New integration -> copy its
#    "Internal Integration Secret" -> NOTION_API_KEY below
# 2. Open the "Career Application Engine" database (already created:
#    https://app.notion.com/p/3e480c2d70db4f2b9b7934c2d8be7d92) -> "..."
#    menu -> Connections -> add your integration
# NOTION_DATA_SOURCE_ID below is already this project's real, provisioned
# tracker — no need to create your own schema.
NOTION_API_KEY=ntn_...
NOTION_DATA_SOURCE_ID=338cc40c-dc76-448d-9d99-23bc6b789405

# --- Indeed (session-cookie based; see SETUP.md's ToS note) ---
INDEED_SESSION_COOKIE=
INDEED_ACCOUNT_EMAIL=nua.consult1@gmail.com

# --- LinkedIn (optional, off by default — see SETUP.md's ToS note) ---
LINKEDIN_SESSION_COOKIE=

# --- Applicant info used to fill forms ---
APPLICANT_FIRST_NAME=Nathan
APPLICANT_LAST_NAME=Asiegbu
APPLICANT_EMAIL=nua.consult1@gmail.com
APPLICANT_PHONE=312-522-0690
# Drop the resume PDF Claude sent you (pulled from your Drive) here as resume.pdf
RESUME_PATH=./resume.pdf

# --- Automation behavior ---
DASHBOARD_PORT=3000
HEADLESS_BROWSER=true
SCREENSHOT_ON_ERROR=true
SCREENSHOT_DIR=./screenshots
LOG_LEVEL=INFO
LOG_DIR=./logs
