# Copy to .env and fill in real values. Never commit .env.
# All of these live ONLY on the machine that actually runs the automation
# (your laptop) — this repo never carries real secrets.

# --- Claude API (job scoring) ---
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_BATCH_SIZE=10
FIT_THRESHOLD=70

# --- Google Sheets tracker ---
# A plain "API key" cannot WRITE to Sheets (Google only allows read-only
# access to public sheets with an API key). Writing rows requires a
# service account: Google Cloud Console -> IAM & Admin -> Service Accounts
# -> Create -> Keys -> Add key (JSON) -> download the file -> share the
# tracker Sheet with the service account's email as an Editor.
GOOGLE_SHEET_ID=1zy-aLjBp2mL9klx3-ASQaqqxdnqe4x9tLTpl572y0r0
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# --- Indeed (session-cookie based; see SETUP.md's ToS note) ---
INDEED_SESSION_COOKIE=
INDEED_ACCOUNT_EMAIL=nua.consult1@gmail.com

# --- LinkedIn (optional, off by default — see SETUP.md's ToS note) ---
LINKEDIN_SESSION_COOKIE=

# --- Applicant info used to fill forms ---
APPLICANT_FIRST_NAME=Nathan
APPLICANT_LAST_NAME=Asiegbu
APPLICANT_EMAIL=nua.consult1@gmail.com
APPLICANT_PHONE=
RESUME_PATH=./resume.pdf

# --- Automation behavior ---
DASHBOARD_PORT=3000
HEADLESS_BROWSER=true
SCREENSHOT_ON_ERROR=true
SCREENSHOT_DIR=./screenshots
LOG_LEVEL=INFO
LOG_DIR=./logs
